# Use one of these. A Google AI Studio key takes priority if both are set.
GEMINI_API_KEY=your_key_here
# GEMINI_MODEL=gemma-4-26b-a4b-it

# OPENROUTER_API_KEY=your_key_here
# OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Optional: Google sign-in. Create an OAuth client (type "Web application") in
# Google Cloud Console and add this authorised redirect URI:
#   http://localhost:3000/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Set when the site is not reached at the address the server sees, e.g. behind a proxy.
# APP_URL=https://your-site.example
